# Copiar a deploy/.env (no versionar) y rellenar. Valores de ejemplo, sin secretos reales.
# Generar secretos:  openssl rand -base64 36
POSTGRES_USER=segurplus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=segurplus
MINIO_ROOT_USER=segurplus
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Backend (puertos de deploy/docker-compose.yml: PostgreSQL 5434, MinIO 9000/9001; backend 8100)
DB_URL=jdbc:postgresql://localhost:5434/segurplus
MINIO_ENDPOINT=http://localhost:9000
JWT_SECRET=change-me-long-random-at-least-32-bytes
APP_CLOCK_FIXED_DATE=2027-01-15
# Semilla de DESARROLLO (usuarios DIR001, ACC001, COM001, EMP001-004). Nunca en producción.
# SEGURPLUS_SEED_DOCUMENTS_SPEC_PATH vacío: los 32 documentos reales los carga `generator` (python -m segurplus_gen.seed). Con la ruta a
# ../docs/data-model/permissions-spec.yaml el backend sembraría fixtures minúsculos (solo para depurar sin el generador).
# La contraseña de los 7 usuarios sale de aquí; también admite SEGURPLUS_SEED_PASSWORDS_<CODIGO> por usuario.
SEGURPLUS_SEED_ENABLED=true
SEGURPLUS_SEED_DEFAULT_PASSWORD=change-me-dev-password
SEGURPLUS_SEED_DOCUMENTS_SPEC_PATH=
# Dify / Gemini (F4, aún sin uso)
DIFY_BASE_URL=http://192.168.0.28:8088/v1
DIFY_APP_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
GEMINI_API_KEY=
