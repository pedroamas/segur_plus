# Plantilla de configuración de SegurPlus. Copiar a deploy/.env (NO se versiona) y sustituir los valores de EJEMPLO.
#   cp .env.example deploy/.env && chmod 600 deploy/.env
# Todos los valores de este fichero son de ejemplo: ninguno es real. Generar secretos propios con openssl:
#   contraseñas:  openssl rand -base64 24        JWT_SECRET:  openssl rand -base64 48
# Uso con el compose:  docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d

# ---------------------------------------------------------------- proyecto y datos
# Nombre del proyecto de compose: contenedores, red y volúmenes con nombre. Cambiarlo permite levantar una copia en paralelo.
COMPOSE_PROJECT_NAME=segurplus
# Directorio de datos (PostgreSQL, MinIO, CA de Caddy). Relativo a deploy/ o absoluto. Una copia necesita su propio DATA_DIR.
# Crearlo antes del primer `up` (si no, Docker lo crea como root):  mkdir -p $DATA_DIR/postgres $DATA_DIR/minio $DATA_DIR/caddy
DATA_DIR=./data
# uid:gid con el que corren MinIO y Caddy para poder escribir en DATA_DIR (ver `id -u` y `id -g`)
LOCAL_UID=1000
LOCAL_GID=1000

# ---------------------------------------------------------------- puertos (en 127.0.0.1, salvo web)
# En un servidor compartido, reservarlos antes de cambiarlos. PostgreSQL, MinIO y backend solo escuchan en 127.0.0.1.
POSTGRES_PORT=5434
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8100
# Web (Caddy, HTTPS): IP de la LAN en la que se publica. NUNCA 0.0.0.0 y NO abrir el puerto en el router.
WEB_BIND_IP=192.168.0.28
WEB_PORT=5174
# A dónde proxifica Caddy /api: el servicio backend del compose (valor por defecto) o, con el backend como proceso del host,
# host.docker.internal:8100 (lo fija docker-compose.host-backend.yml).
BACKEND_UPSTREAM=backend:8100

# ---------------------------------------------------------------- PostgreSQL y MinIO
POSTGRES_USER=segurplus
POSTGRES_PASSWORD=cambia-esta-clave-de-ejemplo-pg
POSTGRES_DB=segurplus
MINIO_ROOT_USER=segurplus
MINIO_ROOT_PASSWORD=cambia-esta-clave-de-ejemplo-minio

# ---------------------------------------------------------------- backend
# Mínimo 32 bytes aleatorios. Si cambia, todas las sesiones caducan.
JWT_SECRET=cambia-este-secreto-jwt-de-ejemplo-de-al-menos-32-bytes
# «Hoy» del negocio (ADR 0006)
APP_CLOCK_FIXED_DATE=2027-01-15
# Solo con el backend FUERA de docker (./mvnw spring-boot:run o java -jar tras `set -a; . deploy/.env; set +a`).
# El compose usa las direcciones internas (postgres:5432, minio:9000) e ignora estas dos.
DB_URL=jdbc:postgresql://localhost:5434/segurplus
MINIO_ENDPOINT=http://localhost:9000

# Semilla de DESARROLLO: crea los 7 usuarios DIR001, ACC001, COM001, EMP001-EMP004. Nunca en producción.
# Los 32 documentos y los datos de negocio los carga el servicio seed (perfil `seed` del compose).
SEGURPLUS_SEED_ENABLED=true
# Clave común de los 7 usuarios seed (también admite SEGURPLUS_SEED_PASSWORDS_<CODIGO> por usuario).
SEGURPLUS_SEED_DEFAULT_PASSWORD=cambia-esta-clave-de-ejemplo
# Vacío: no sembrar los fixtures minúsculos del backend (los documentos reales los carga el seed)
SEGURPLUS_SEED_DOCUMENTS_SPEC_PATH=

# ---------------------------------------------------------------- Dify y Gemini
# Dify NO está en el compose: es una instancia aparte (URL SIN /v1). Comprobar:  scripts/check-dify.sh
DIFY_BASE_URL=http://192.168.0.28:8088
# Las escribe deploy/dify/provision_dify.py (idempotente). Sin ellas el chat responde 503 y el indexador no corre.
# Con el perfil `mockdify` (Dify SIMULADO, solo pruebas): DIFY_BASE_URL=http://mockdify:8080 y cualquier valor no vacío en las 3 primeras.
DIFY_KNOWLEDGE_API_KEY=
DIFY_APP_API_KEY=
DIFY_APP_API_KEY_FALLBACK=
DIFY_PLANNER_API_KEY=
DIFY_PLANNER_API_KEY_FALLBACK=
# Indexador de documentos en Dify (job cada 30 s)
AI_INDEXER_ENABLED=true
# Solo para provision_dify.py (configura el proveedor Gemini en Dify); el backend no la lee. Capa gratuita: ~20 peticiones/día.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_FALLBACK=gemini-3.5-flash
